{
  "version": 2,
  "routeMode": "priority",
  "fallbackSpecies": "primary",
  "species": [
    {
      "id": "primary",
      "label": "Primary OpenClaw fallback",
      "enabled": true,
      "type": "openclaw",
      "bin": "openclaw",
      "binEnv": "FORGE_SPECIES_PRIMARY_BIN",
      "agent": "main",
      "local": true,
      "timeoutMs": 240000,
      "strengths": ["fallback", "connected tools", "current OpenClaw environment"]
    },
    {
      "id": "sol",
      "label": "OpenAI GPT-5.6 Sol",
      "enabled": true,
      "requiresEnv": ["OPENAI_API_KEY"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "openai", "--model", "gpt-5.6-sol", "--effort", "max", "--prompt", "{prompt}"],
      "timeoutMs": 360000,
      "strengths": ["frontier general reasoning", "coding", "research", "computer use", "design", "meta-synthesis"]
    },
    {
      "id": "terra",
      "label": "OpenAI GPT-5.6 Terra",
      "enabled": true,
      "requiresEnv": ["OPENAI_API_KEY"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "openai", "--model", "gpt-5.6-terra", "--effort", "high", "--prompt", "{prompt}"],
      "timeoutMs": 300000,
      "strengths": ["balanced frontier reasoning", "subagents", "tool workflows", "cost-quality balance"]
    },
    {
      "id": "luna",
      "label": "OpenAI GPT-5.6 Luna",
      "enabled": true,
      "requiresEnv": ["OPENAI_API_KEY"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "openai", "--model", "gpt-5.6-luna", "--effort", "medium", "--prompt", "{prompt}"],
      "timeoutMs": 240000,
      "strengths": ["high-volume subagents", "classification", "fast support work"]
    },
    {
      "id": "fable",
      "label": "Anthropic Claude Fable 5",
      "enabled": true,
      "requiresEnv": ["ANTHROPIC_API_KEY"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "anthropic", "--model", "claude-fable-5", "--max-tokens", "24000", "--prompt", "{prompt}"],
      "timeoutMs": 420000,
      "strengths": ["long-horizon coding", "hard knowledge work", "judgment", "autonomous verification", "nuanced critique"]
    },
    {
      "id": "sonnet5",
      "label": "Anthropic Claude Sonnet 5",
      "enabled": true,
      "requiresEnv": ["ANTHROPIC_API_KEY"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "anthropic", "--model", "claude-sonnet-5", "--max-tokens", "18000", "--prompt", "{prompt}"],
      "timeoutMs": 300000,
      "strengths": ["agentic execution", "coding", "tool use", "efficient autonomous subagents"]
    },
    {
      "id": "gemini-pro",
      "label": "Google Gemini 3.1 Pro",
      "enabled": true,
      "requiresEnv": ["GEMINI_API_KEY"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "gemini", "--model", "gemini-3.1-pro-preview", "--effort", "high", "--prompt", "{prompt}"],
      "timeoutMs": 360000,
      "strengths": ["complex multimodal reasoning", "creative concepts", "broad world knowledge", "design ideation"]
    },
    {
      "id": "gemini-flash",
      "label": "Google Gemini 3.6 Flash",
      "enabled": true,
      "requiresEnv": ["GEMINI_API_KEY"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "gemini", "--model", "gemini-3.6-flash", "--effort", "medium", "--prompt", "{prompt}"],
      "timeoutMs": 240000,
      "strengths": ["fast agentic loops", "multimodal understanding", "spatial reasoning", "scouting", "high-throughput subagents"]
    },
    {
      "id": "gemini-deep",
      "label": "Google Gemini 3.1 Deep Think wrapper",
      "enabled": true,
      "requiresEnv": ["FORGE_GEMINI_DEEP_BIN"],
      "type": "command",
      "binEnv": "FORGE_GEMINI_DEEP_BIN",
      "argsEnv": "FORGE_GEMINI_DEEP_ARGS_JSON",
      "args": ["--prompt", "{prompt}"],
      "timeoutMs": 600000,
      "strengths": ["mathematics", "science", "engineering", "deep formal reasoning"]
    },
    {
      "id": "grok-45",
      "label": "xAI Grok 4.5",
      "enabled": true,
      "requiresEnv": ["XAI_API_KEY"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "xai", "--model", "grok-4.5", "--prompt", "{prompt}"],
      "timeoutMs": 300000,
      "strengths": ["engineering", "coding", "agentic work", "lateral exploration", "independent contrarian line"]
    },
    {
      "id": "kimi-code",
      "label": "Kimi K2.7 Code / compatible endpoint",
      "enabled": true,
      "requiresEnv": ["FORGE_KIMI_BASE_URL"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "openai-compatible", "--base-url-env", "FORGE_KIMI_BASE_URL", "--api-key-env", "FORGE_KIMI_API_KEY", "--model", "Kimi-K2.7-Code", "--prompt", "{prompt}"],
      "timeoutMs": 360000,
      "strengths": ["open-weight independent coding", "reasoning", "vision-capable coding"]
    },
    {
      "id": "glm-long",
      "label": "GLM-5.2 / compatible endpoint",
      "enabled": true,
      "requiresEnv": ["FORGE_GLM_BASE_URL"],
      "type": "command",
      "bin": "node",
      "args": ["scripts/forge-api-backend.mjs", "--provider", "openai-compatible", "--base-url-env", "FORGE_GLM_BASE_URL", "--api-key-env", "FORGE_GLM_API_KEY", "--model", "GLM-5.2", "--prompt", "{prompt}"],
      "timeoutMs": 420000,
      "strengths": ["open-weight long-horizon tasks", "large context", "agentic engineering", "independent model lineage"]
    }
  ],
  "routes": {
    "default": ["sol", "fable", "primary"],
    "builder": ["fable", "sol", "sonnet5", "primary"],
    "skeptic": ["fable", "sol", "grok-45", "primary"],
    "systems": ["sol", "fable", "gemini-pro", "primary"],
    "empiricist": ["gemini-deep", "gemini-pro", "sol", "primary"],
    "black-swan": ["grok-45", "gemini-pro", "sol", "primary"],
    "minimalist": ["sol", "fable", "primary"],
    "judge": ["fable", "sol", "primary"],
    "meta-judge": ["sol", "fable", "primary"],
    "critic": ["fable", "grok-45", "sol", "primary"],
    "synth": ["sol", "fable", "gemini-pro", "primary"],
    "verifier": ["gemini-pro", "fable", "sol", "primary"],
    "mutator": ["grok-45", "gemini-pro", "sol", "primary"],
    "evolution": ["sol", "fable", "primary"],
    "predator": ["grok-45", "fable", "sol", "primary"],
    "archetype-router": ["sol", "fable", "gemini-flash", "primary"]
  }
}
